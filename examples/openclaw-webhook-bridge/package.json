{
  "name": "@mail4ai/openclaw-webhook-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw webhook bridge example for Mail4AI email.received notifications.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "pretest": "npm run build --workspace @mail4ai/webhook-kit",
    "pretypecheck": "npm run build --workspace @mail4ai/webhook-kit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mail4ai/webhook-kit": "0.1.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
